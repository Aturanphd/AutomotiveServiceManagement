@model Vehicle
@{ ViewData["Title"] = "Araç detayları"; }
<a class="back-link" asp-action="Index">← Listeye dön</a><div class="page-heading"><div><p class="eyebrow">KAYIT DETAYI / #@Model.Id</p><h1>Araç detayları</h1></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a></div>

<section class="panel detail"><h2>@Model.Plate <span class="muted">· @Model.Brand @Model.Model</span></h2><p>@Model.Year · @Model.Mileage.ToString("N0") km</p><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Müşteri: @Model.Customer.Name →</a></section>
<section class="panel"><div class="section-heading"><h2>Servis geçmişi</h2><a class="btn btn-primary" asp-controller="Services" asp-action="Create" asp-route-vehicleId="@Model.Id">+ Servis aç</a></div>
@if (Model.Services.Count == 0) { <p class="empty">Henüz servis kaydı yok. İlk servis kaydını açabilirsiniz.</p> }
@foreach (var s in Model.Services) { <p class="list-row"><strong>@s.Date.ToString("dd.MM.yyyy")</strong><span>@s.Description · @s.StatusText</span><a asp-controller="Services" asp-action="Details" asp-route-id="@s.Id">İncele →</a></p> }</section>

<details class="danger-zone"><summary>Kaydı silme seçenekleri</summary><p>Bağlı kayıtlar varsa silme engellenir. Bu işlem geri alınamaz.</p><form method="post" asp-action="Delete" data-confirm="Bu kaydı silmek istediğinizden emin misiniz?"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><button class="btn btn-outline-danger">Kaydı sil</button></form></details>
