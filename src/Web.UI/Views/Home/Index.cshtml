@model Dashboard
@{ ViewData["Title"] = "Genel bakış"; }
<div class="page-heading dashboard-heading"><div><p class="eyebrow">SERVİSİNİZİN BUGÜNÜ</p><h1>Genel bakış</h1><p>Atölyenizdeki tüm hareketler, bir bakışta.</p></div><span class="today-label">@DateTime.Today.ToString("dd MMMM yyyy, dddd")</span></div>
<section class="workshop-hero"><div class="hero-copy"><span class="hero-kicker"><span></span> ATÖLYENİZİN KONTROL MERKEZİ</span><h2>İyi hizmet,<br/><em>düzenli bir atölyeyle başlar.</em></h2><p>Müşteri kabulünden araç teslimine kadar her adımı<br class="desktop-break"/> tek yerden, güvenle takip edin.</p><div class="hero-actions"><a class="btn btn-copper" asp-controller="Services" asp-action="Create">+ Yeni servis aç</a><a class="hero-secondary" asp-controller="Vehicles" asp-action="Index">Araçları incele <span>↗</span></a></div></div><div class="hero-visual" aria-hidden="true"><div class="hero-orbit"></div><span class="hero-line-label">BAKIM · ONARIM · TAKİP</span><img src="~/images/workshop-car.svg" alt=""/><div class="hero-caption"><span class="hero-status-dot"></span> Her detay kayıt altında <span>01 — 05</span></div></div></section>
<div class="metrics"><a asp-controller="Customers" asp-action="Index" class="metric"><div class="metric-top"><span>TOPLAM MÜŞTERİ</span><partial name="_Icon" model='@("Customers")'/></div><strong>@Model.Customers</strong><small>Müşteri kayıtlarını incele <b>↗</b></small></a><a asp-controller="Vehicles" asp-action="Index" class="metric"><div class="metric-top"><span>KAYITLI ARAÇ</span><partial name="_Icon" model='@("Vehicles")'/></div><strong>@Model.Vehicles</strong><small>Araç geçmişlerine ulaş <b>↗</b></small></a><a asp-controller="Services" asp-action="Index" class="metric accent"><div class="metric-top"><span>AÇIK SERVİS</span><partial name="_Icon" model='@("Services")'/></div><strong>@Model.OpenServices</strong><small>İşlem bekleyen dosyalar <b>↗</b></small></a><div class="metric"><div class="metric-top"><span>TAMAMLANAN SERVİS TUTARI</span><partial name="_Icon" model='@("Revenue")'/></div><strong>@((Model.CompletedCents / 100m).ToString("C0"))</strong><small>Tüm zamanlar · tahsilat değildir</small></div></div>
<div class="dashboard-grid"><section class="panel"><div class="section-heading"><h2>Son servis kayıtları</h2><a asp-controller="Services" asp-action="Index">Tümünü gör →</a></div>
@if (Model.Recent.Count == 0) { <p class="empty">Önce müşteri ve araç ekleyip ilk servisinizi açın.</p> }
@foreach (var s in Model.Recent) { <a class="service-row" asp-controller="Services" asp-action="Details" asp-route-id="@s.Id"><span class="car-icon">@s.Vehicle.Brand[..1]</span><div><strong>@s.Vehicle.Plate</strong><span>@s.Description</span></div><span class="status">@s.StatusText</span><strong>@((s.TotalCents / 100m).ToString("C0"))</strong></a> }
</section><section class="panel"><div class="section-heading"><h2>Stok uyarıları</h2><span class="warning-dot">Kontrol listesi</span></div>
@if (Model.LowStock.Count == 0) { <p class="empty">Kritik seviyede parça yok.</p> }
@foreach (var p in Model.LowStock) { <a class="stock-row" asp-controller="Parts" asp-action="Details" asp-route-id="@p.Id"><div><strong>@p.Name</strong><small>@p.Code · Eşik @p.MinimumStock adet</small></div><span>@p.Stock adet</span></a> }
<p class="panel-note">Stok girişi için parçanın detay ekranını açın.</p></section></div>
<section class="guide-banner"><div><p class="eyebrow">DOĞRU SIRAYLA, KOLAYCA</p><h2>Bir servis kaydı nasıl oluşturulur?</h2><p>01 Müşteriyi kaydet <span>→</span> 02 Aracını ekle <span>→</span> 03 Servisi aç <span>→</span> 04 Parçaları ekle ve tamamla</p></div><a class="btn btn-outline-primary" asp-controller="Home" asp-action="Help">Rehberi aç →</a></section>
