@model ServiceRecord
@{ ViewData["Title"] = "Servis detayları"; }
<a class="back-link" asp-action="Index">← Servis kayıtları</a><div class="page-heading"><div><p class="eyebrow">SERVİS DOSYASI</p><h1>SRV-@Model.Id.ToString("D4") <span class="status">@Model.StatusText</span></h1><p>@Model.Vehicle.Plate · @Model.Vehicle.Brand @Model.Vehicle.Model · @Model.Vehicle.Customer.Name</p></div><strong class="total">@((Model.TotalCents / 100m).ToString("C2"))</strong></div>
<section class="panel detail"><div class="section-heading"><h2>İşlem bilgileri</h2><span>@Model.Date.ToString("dd.MM.yyyy") · @Model.Mileage.ToString("N0") km</span></div><p class="preserve">@Model.Description</p><p>İşçilik: @((Model.LaborCents / 100m).ToString("C2"))</p><a asp-controller="Vehicles" asp-action="Details" asp-route-id="@Model.VehicleId">Araç geçmişini gör →</a></section>
<section class="panel"><div class="section-heading"><h2>Kullanılan parçalar</h2><small>Fiyatlar ekleme anında sabitlenir.</small></div>
@if (Model.Parts.Count == 0) { <p class="empty">Henüz parça eklenmedi. Parçasız servis de tamamlanabilir.</p> } else {
<div class="table-responsive"><table class="table"><thead><tr><th>Parça</th><th>Miktar</th><th>Birim fiyat</th><th>Tutar</th></tr></thead><tbody>@foreach (var p in Model.Parts) { <tr><td>@p.Part.Name</td><td>@p.Quantity</td><td>@((p.UnitPriceCents / 100m).ToString("C2"))</td><td>@(((long)p.Quantity * p.UnitPriceCents / 100m).ToString("C2"))</td></tr> }</tbody></table></div> }
@if (Model.Status == ServiceStatus.Open) {
<div class="detail"><h3>Parça ekle</h3><p>Eklenen miktar stoktan düşer. Aynı parça bir kez eklenebilir; miktarı kontrol ediniz.</p><form method="post" asp-action="AddPart" class="inline-form"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><label for="part">Parça</label><select id="part" name="partId" asp-items="ViewBag.Parts" class="form-select @(ViewBag.PartSelectionInvalid == true ? "is-invalid" : "")" aria-invalid="@(ViewBag.PartSelectionInvalid == true ? "true" : "false")" required><option value="">Stoktaki parçayı seçiniz</option></select><label for="quantity">Miktar</label><input id="quantity" name="quantity" type="number" min="1" max="10000" value="1" class="form-control" required/><button class="btn btn-primary">Parçayı ekle</button></form></div>
}</section>
@if (Model.Status == ServiceStatus.Open) {
<section class="panel detail"><h2>Servisi kapat</h2><p>Tamamlanan veya iptal edilen kayıt değiştirilemez. İptalde kullanılan parçalar stoğa döner.</p><div class="action-row">
@foreach (var action in new[] { (ServiceStatus.Completed, "Servisi tamamla", "btn-primary"), (ServiceStatus.Cancelled, "Servisi iptal et", "btn-outline-danger") }) {
<form method="post" asp-action="ChangeStatus" data-confirm="Bu işlem geri alınamaz. Devam edilsin mi?"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><input name="status" type="hidden" value="@action.Item1"/><button class="btn @action.Item3">@action.Item2</button></form> }</div></section>
} else { <div class="alert alert-info">Bu dosya kapatıldı. Geçmişi korumak için değişiklik yapılamaz.</div> }
