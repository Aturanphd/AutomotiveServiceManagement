@model Customer
@{ ViewData["Title"] = "Müşteri detayları"; }
<a class="back-link" asp-action="Index">← Listeye dön</a><div class="page-heading"><div><p class="eyebrow">KAYIT DETAYI / #@Model.Id</p><h1>Müşteri detayları</h1></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a></div>

<section class="panel detail"><h2>@Model.Name</h2><p>@Model.Phone · @(Model.Email ?? "E-posta belirtilmedi")</p></section>
<section class="panel"><div class="section-heading"><h2>Bağlı araçlar</h2><a asp-controller="Vehicles" asp-action="Edit">+ Araç ekle</a></div>
@if (Model.Vehicles.Count == 0) { <p class="empty">Henüz araç yok. Araç eklerken bu müşteriyi seçiniz.</p> }
@foreach (var v in Model.Vehicles) { <p class="list-row"><strong>@v.Plate</strong><span>@v.Brand @v.Model</span><a asp-controller="Vehicles" asp-action="Details" asp-route-id="@v.Id">Aracı incele →</a></p> }</section>

<details class="danger-zone"><summary>Kaydı silme seçenekleri</summary><p>Bağlı kayıtlar varsa silme engellenir. Bu işlem geri alınamaz.</p><form method="post" asp-action="Delete" data-confirm="Bu kaydı silmek istediğinizden emin misiniz?"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><button class="btn btn-outline-danger">Kaydı sil</button></form></details>
