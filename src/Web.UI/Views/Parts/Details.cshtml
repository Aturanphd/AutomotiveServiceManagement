@model Part
@{ ViewData["Title"] = "Parça detayları"; }
<a class="back-link" asp-action="Index">← Listeye dön</a><div class="page-heading"><div><p class="eyebrow">KAYIT DETAYI / #@Model.Id</p><h1>Parça detayları</h1></div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a></div>

<section class="panel detail"><p class="eyebrow">@Model.Code</p><h2>@Model.Name</h2><p>Birim fiyat: @((Model.PriceCents / 100m).ToString("C2"))</p><p>Mevcut stok: <strong>@Model.Stock adet</strong> · Kritik eşik: @Model.MinimumStock</p>
@if (Model.Stock <= Model.MinimumStock) { <p class="stock-warning">Kritik stok: tedarik planlayınız.</p> }</section>
<section class="panel detail"><h2>Stok girişi</h2><p>Teslim alınan miktarı giriniz. Stok çıkışı servis kaydından otomatik yapılır.</p><form method="post" asp-action="Receive" class="inline-form"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><label for="quantity">Gelen miktar</label><input id="quantity" name="quantity" type="number" min="1" max="10000" value="1" class="form-control" required/><button class="btn btn-primary">Stoğa ekle</button></form></section>

<details class="danger-zone"><summary>Kaydı silme seçenekleri</summary><p>Bağlı kayıtlar varsa silme engellenir. Bu işlem geri alınamaz.</p><form method="post" asp-action="Delete" data-confirm="Bu kaydı silmek istediğinizden emin misiniz?"><input name="id" type="hidden" value="@Model.Id"/><input name="version" type="hidden" value="@Model.Version"/><button class="btn btn-outline-danger">Kaydı sil</button></form></details>
